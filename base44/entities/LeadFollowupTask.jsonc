{
  "name": "LeadFollowupTask",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_to": {
      "type": "string"
    },
    "assignee_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "completed"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "open"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "parent_task_id": {
      "type": "string",
      "description": "Parent follow-up task for a subtask"
    },
    "previous_task_id": {
      "type": "string",
      "description": "Previous task this follow-up continues"
    }
  },
  "required": [
    "lead_id",
    "title",
    "due_date",
    "assigned_to",
    "assignee_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}