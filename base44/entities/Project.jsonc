{
  "name": "Project",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Link to Client entity (SSOT hub)"
    },
    "sale_id": {
      "type": "string",
      "description": "Link to originating Sale"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "preconstruction",
        "construction"
      ],
      "description": "Project type"
    },
    "title": {
      "type": "string",
      "description": "Project name"
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_to_be_scheduled",
        "mobilization",
        "active_construction",
        "substantial_completion_closeout",
        "closed"
      ],
      "default": "awaiting_to_be_scheduled",
      "description": "Project stage"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "entered_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "History of status transitions with timestamps"
    },
    "contract_value": {
      "type": "number",
      "description": "Total contract value"
    },
    "actual_costs": {
      "type": "number",
      "default": 0,
      "description": "Actual costs incurred"
    },
    "actual_margin": {
      "type": "number",
      "description": "Calculated margin percentage"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "target_completion_date": {
      "type": "string",
      "format": "date"
    },
    "actual_completion_date": {
      "type": "string",
      "format": "date"
    },
    "project_manager_id": {
      "type": "string"
    },
    "gm_report_assignee_id": {
      "type": "string"
    },
    "crew_assignment": {
      "type": "string",
      "enum": [
        "crew_a",
        "crew_b",
        "crew_c",
        "crew_d",
        "unassigned"
      ],
      "default": "unassigned"
    },
    "color": {
      "type": "string"
    },
    "include_in_forecast": {
      "type": "boolean",
      "default": true
    },
    "forecast_build_type": {
      "type": "string",
      "enum": [
        "in_house",
        "subcontractor",
        "mixed"
      ],
      "default": "in_house"
    },
    "monthly_revenue_allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "month": {
            "type": "number"
          },
          "percentage": {
            "type": "number"
          }
        }
      }
    },
    "monthly_sub_allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "month": {
            "type": "number"
          },
          "sub_percentage": {
            "type": "number"
          }
        }
      }
    },
    "monthly_work_allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "month": {
            "type": "number"
          },
          "percentage": {
            "type": "number"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "hours_logged": {
            "type": "number"
          },
          "budget": {
            "type": "number"
          },
          "actual_cost": {
            "type": "number"
          },
          "is_invoiceable": {
            "type": "boolean"
          },
          "invoice_amount": {
            "type": "number"
          },
          "invoice_date": {
            "type": "string",
            "format": "date"
          },
          "commission_processed": {
            "type": "boolean"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "recognition_mode": {
      "type": "string",
      "enum": [
        "standard",
        "monthly_actual"
      ],
      "enumColors": [
        "gray",
        "blue"
      ]
    },
    "inventory_status": {
      "type": "string",
      "enum": [
        "none",
        "held",
        "sold"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ],
      "default": "none"
    },
    "inventory_sale_date": {
      "type": "string",
      "format": "date"
    },
    "inventory_sale_price": {
      "type": "number",
      "minimum": 0
    },
    "recognition_revision": {
      "type": "number",
      "default": 0
    },
    "monthly_actual_allocations": {
      "type": "array",
      "description": "Independent incurred costs, revenue and realized GP; costs are not deducted again from entered GP.",
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string"
          },
          "costs": {
            "type": "number",
            "minimum": 0
          },
          "revenue": {
            "type": "number",
            "minimum": 0
          },
          "gp": {
            "type": "number"
          }
        },
        "required": [
          "period",
          "costs",
          "revenue",
          "gp"
        ]
      }
    }
  },
  "required": [
    "client_id",
    "sale_id",
    "project_type",
    "title"
  ]
}