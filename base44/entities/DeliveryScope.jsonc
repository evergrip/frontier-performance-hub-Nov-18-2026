{
  "name": "DeliveryScope",
  "type": "object",
  "properties": {
    "estimate_id": {
      "type": "string"
    },
    "scope_name": {
      "type": "string"
    },
    "cost_code": {
      "type": "string"
    },
    "subtrade_id": {
      "type": "string"
    },
    "sub_name": {
      "type": "string"
    },
    "sub_quote": {
      "type": "number",
      "minimum": 0
    },
    "sub_supplies_materials": {
      "type": "boolean",
      "description": "Whether the subcontractor quote includes materials."
    },
    "materials_by_frontier": {
      "type": "number",
      "minimum": 0,
      "description": "Frontier material cost for this full scope. If the quote includes materials, this cost only applies to the in-house share; otherwise Frontier supplies all materials."
    },
    "frontier_material_markup_pct": {
      "type": "number",
      "minimum": 0,
      "description": "Optional cost markup for materials supplied by Frontier in the all-subcontracted baseline. Blank uses standard pricing."
    },
    "selections": {
      "type": "number",
      "minimum": 0
    },
    "equipment": {
      "type": "number",
      "minimum": 0
    },
    "other": {
      "type": "number",
      "minimum": 0
    },
    "inhouse_feasible": {
      "type": "boolean",
      "default": false
    },
    "inhouse_hours": {
      "type": "number",
      "minimum": 0
    },
    "inhouse_extra_materials": {
      "type": "number",
      "minimum": 0
    },
    "scheduled_start_month": {
      "type": "string"
    },
    "duration_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "default": 1
    },
    "inhouse_share": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "decision_notes": {
      "type": "string"
    }
  },
  "required": [
    "estimate_id",
    "scope_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}