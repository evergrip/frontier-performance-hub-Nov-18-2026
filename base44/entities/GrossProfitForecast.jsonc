{
  "name": "GrossProfitForecast",
  "type": "object",
  "properties": {
    "job_key": {
      "type": "string"
    },
    "precon_sale_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "probable_start_date": {
      "type": "string",
      "format": "date"
    },
    "total_gp": {
      "type": "number",
      "minimum": 0
    },
    "total_revenue": {
      "type": "number",
      "minimum": 0
    },
    "allocation_mode": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ]
    },
    "monthly_allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string"
          },
          "gp": {
            "type": "number",
            "minimum": 0
          },
          "revenue": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "period",
          "gp",
          "revenue"
        ]
      }
    },
    "annual_gp_goal": {
      "type": "number",
      "minimum": 0
    },
    "goal_fiscal_year": {
      "type": "number"
    },
    "weekly_gp": {
      "type": "number",
      "minimum": 0
    },
    "weekly_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "amount"
        ]
      }
    },
    "revision": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "job_key",
    "probable_start_date",
    "total_gp",
    "annual_gp_goal",
    "goal_fiscal_year",
    "weekly_gp"
  ]
}