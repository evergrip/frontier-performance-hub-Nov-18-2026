{
  "name": "DeliveryEstimate",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "job_number": {
      "type": "string"
    },
    "start_month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "override_contract_price": {
      "type": "number",
      "minimum": 0
    },
    "labour_rate_override": {
      "type": "number",
      "minimum": 0
    },
    "prepared_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "start_month",
    "prepared_by"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}