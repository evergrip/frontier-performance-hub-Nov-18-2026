{
  "name": "PreCon Auto Handoff on Lead Conversion",
  "description": "When a Lead is converted (converted_to_sale_id set), automatically creates PreconProgress records for the first 5 stages with pre-populated data.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"converted_to_sale_id\") != null) and (.trigger.data.converted_to_sale_id != null and .trigger.data.converted_to_sale_id != \"\" and .trigger.data.converted_to_sale_id != [] and .trigger.data.converted_to_sale_id != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "precon_auto_handoff_on_lead_conversion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "preconAutoHandoff",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "preconAutoHandoff"
  }
}