{
  "name": "Notify Salesperson on Lead Assignment",
  "description": "Sends an email to the assigned salesperson when a new lead is created or reassigned",
  "trigger": {
    "condition": "${ ((.trigger.data.assigned_to != null and .trigger.data.assigned_to != \"\" and .trigger.data.assigned_to != [] and .trigger.data.assigned_to != {}) or (.trigger.changed_fields | index(\"assigned_to\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_salesperson_on_lead_assignment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyLeadAssigned",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyLeadAssigned"
  }
}